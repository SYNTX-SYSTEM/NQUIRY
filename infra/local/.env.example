# Copy to .env at the repository root for local Docker Compose use.
# Never commit a real .env (14 §33 SECRETS AND CONFIGURATION).

POSTGRES_USER=nquiry
POSTGRES_PASSWORD=nquiry_local_dev_only
POSTGRES_DB=nquiry
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://nquiry:nquiry_local_dev_only@localhost:5432/nquiry
